# --- БАРС МЭИ ---
# Логин и пароль от учётной записи МЭИ (ОСЭП), как на странице входа в БАРС
BARS_LOGIN=IvanovII
BARS_PASSWORD=твой_пароль
# Секретный ключ TOTP: БАРС → профиль → «Аутентификация» → «Одноразовые коды TOTP» →
# «Данные для добавления вручную» → «Секретный ключ». С ним бот проходит 2FA сам.
# Если оставить пустым, бот будет просить код (из MAX/ВК) в Telegram.
BARS_TOTP_SECRET=

# Оставь пустыми — бот сам находит «Оценки БАРС» и «Посещение занятий» в кабинете.
# Заполнять, только если бот попросит.
# ID кабинета студента (из адреса «Оценки БАРС»: ...Main?studentID=ВОТ_ЭТО).
# Нужен, если после входа БАРС открывает главное меню (например, у старост).
STUDENT_ID=
MARKS_URL=
ABSENCES_URL=

# --- Telegram ---
# Токен от @BotFather
TG_TOKEN=123456789:AA...
# Твой chat id: запусти бота, напиши ему /start — он пришлёт число
TG_CHAT_ID=

# --- Расписание ---
# Как часто проверять, в минутах
CHECK_INTERVAL_MIN=20
# Ночью не проверять (московское время), например 1-7. Пусто — проверять всегда.
QUIET_HOURS=1-7
# Итог без изменений — один раз в день, московское время.
DAILY_REPORT_TIME=21:00
# Отдельное хранилище дел, физры и ежедневной статистики.
PERSONAL_FILE=personal.json
